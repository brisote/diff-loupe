{
  "name": "diffloupe-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "astro dev",
    "dev:ai": "PUBLIC_AI_REVIEW=1 astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:ai": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_AI_REVIEW=1 astro build",
    "preview": "astro preview",
    "lint": "biome ci . && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "links": "python3 scripts/check_links.py dist"
  },
  "dependencies": {
    "astro": "7.4.8",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "sharp": "0.35.5",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
