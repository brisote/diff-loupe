---
import { repository } from "../../lib/links";
import Icon from "../Icon.astro";
import Shot from "../Shot.astro";
---
<section class="wrap hero">
  <h1 class="h1-hero">Review the diff. Ship the branch.<br />Stay private.</h1>
  <p class="lead">Diffloupe is a Mac app for reading git changes: side-by-side diffs, the branch log, rendered Markdown and a 3-pane merge window. Your code stays on your Mac.</p>
  <div class="hero-actions">
    <a class="btn btn-primary btn-lg" href="/download/"><Icon name="download" size="sm" />Download for Mac</a>
  </div>
  <ul class="chips" aria-label="Requirements">
    <li class="chip"><Icon name="chip" />Apple silicon</li>
    <li><a class="chip chip-link" href={repository}><Icon name="github" />Open source</a></li>
    <li class="chip"><Icon name="no-account" />No account</li>
  </ul>
  <div class="scene" role="img" aria-label="Diffloupe on a Mac desktop, showing an API document rendered side by side with its changes marked">
    <div class="scene-bar" aria-hidden="true">
      <span class="scene-tile"><img src="/icon.png" alt="" /></span>
      <span class="scene-status"><Icon name="wifi" /><Icon name="battery" /></span>
    </div>
    <div class="scene-window">
      <div class="window"><Shot scene="markdown" alt="" sizes="(max-width: 767px) 86vw, 806px" eager /></div>
    </div>
  </div>
</section>
