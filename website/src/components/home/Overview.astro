---
import Shot from "../Shot.astro";

const tiles = [
  {
    scene: "markdown",
    crop: "crop-words",
    sizes: "874px",
    title: "Rendered Markdown",
    alt: "Rendered Markdown diff with changed words and table cells marked",
    text: "Read Markdown changes as a page, with every changed word and table cell marked.",
  },
  {
    scene: "changes",
    crop: "crop-list",
    sizes: "1224px",
    title: "Changes list",
    alt: "Changes list with files staged and unstaged",
    text: "Every changed file at a glance, with file status badges and line change counts.",
  },
  {
    scene: "changes",
    crop: "crop-words",
    sizes: "874px",
    title: "Word highlights",
    alt: "Changed words highlighted inside a line of Kotlin",
    text: "Changed words stand out inside each line, and unchanged code folds away.",
  },
  {
    scene: "merge",
    crop: "crop-window",
    sizes: "366px",
    title: "3-pane merge",
    alt: "The 3-pane merge window with yours, the result and theirs",
    text: "Yours, the result and theirs side by side when a merge has conflicts.",
  },
];
---
<section class="band" aria-labelledby="overview">
  <div class="wrap">
    <div class="band-head">
      <span class="chip chip-section">macOS · Windows · Linux · Open source</span>
      <h2 class="h2" id="overview">Markdown and code in one window</h2>
      <p class="sub">Read Markdown changes rendered as a page instead of raw syntax. Pick your branch and a target branch, and Diffloupe shows every Markdown and code change between them live while you work.</p>
    </div>
    <div class="grid4">
      {tiles.map((tile) => (
        <div class="grid4-cell" data-reveal>
          <div class="tile-wrap"><div class="tile"><Shot scene={tile.scene} class={tile.crop} alt={tile.alt} sizes={tile.sizes} /></div></div>
          <h3 class="eyebrow cap">{tile.title}</h3>
          <p class="cap-text">{tile.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
