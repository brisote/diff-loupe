---
import { aiReviewEnabled } from "../../lib/features";
import Icon from "../Icon.astro";

const steps = ["Paste the command", "Open Diffloupe", "Pick a repository"];
const questions = [
  [
    "What is Diffloupe?",
    "Diffloupe is an app for reviewing Markdown and git changes on macOS, Windows and Linux. It renders Markdown diffs as a page with changed words and tables marked, and shows every code change on your branch with side-by-side diffs, the branch log and a 3-pane merge window.",
  ],
  [
    "What do I need?",
    "macOS 13 or later on Apple silicon, Windows 10 (22H2) or Windows 11 on 64-bit, or 64-bit Linux with Ubuntu 22.04, Debian 12 or Fedora 40 or later.",
  ],
  [
    "Why install with a command?",
    "Diffloupe is not signed by Apple or Microsoft yet, so macOS and Windows warn about a copy downloaded in a browser at its first start. The command installs it without that warning, and it checks the download first.",
  ],
  [
    "Where does my code go?",
    aiReviewEnabled
      ? "For manual review, nowhere. Your repositories and settings stay on your computer. When you opt into AI review, your repository is uploaded over HTTPS with explicit consent, analyzed in two stages, and deleted from the server immediately after generation, along with the report."
      : "Nowhere. Your repositories and settings stay on your computer. Diffloupe is open source, so you can check every line of what it does.",
  ],
  [
    "How do I update?",
    "Diffloupe tells you when a new version is out and installs it with one click, keeping your settings. Running the install command again works too.",
  ],
  [
    "How do I remove it?",
    "Choose Uninstall Diffloupe… in the settings menu. It removes the app and the data it stored.",
  ],
];
---
<section class="start" id="faq" aria-label="Quick start and questions">
  <div class="quick">
    <p class="eyebrow">Quick start</p>
    <h2>Ready in under a minute</h2>
    <ol class="steps">
      {steps.map((step, index) => <li><span class="step-num">{index + 1}</span>{step}</li>)}
    </ol>
    <span class="sticker">{aiReviewEnabled ? "No account for manual review." : "No account needed."}</span>
  </div>
  <div class="faq">
    {questions.map(([question, answer], index) => (
      <details open={index === 0}><summary>{question}<Icon name="chevron-down" /></summary><p class="faq-a">{answer}</p></details>
    ))}
  </div>
</section>
