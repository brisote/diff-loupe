---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { siteUrl } from "../lib/seo";
import "../styles/fonts.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "download" | "changelog" | "privacy";
  indexed?: boolean;
  data?: Record<string, unknown>;
}

const { title, description, current, indexed = true, data } = Astro.props;
const site = Astro.site ?? siteUrl;
const canonical = new URL(Astro.url.pathname, site).href;
const image = new URL("/og.jpg", site).href;
const imageAlt = "Diffloupe showing a README rendered side by side with its changes marked";
const policy =
  "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={policy} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    {indexed ? <link rel="canonical" href={canonical} /> : <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Diffloupe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {indexed && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    {data && <script type="application/ld+json" set:html={JSON.stringify(data).replaceAll("<", "\\u003c")} />}
    <link rel="preload" href="/fonts/GoogleSansFlex.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="site">
      <div class="page">
        <Header current={current} />
        <main>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
