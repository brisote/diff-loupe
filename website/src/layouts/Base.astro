---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/fonts.css";
import "../styles/site.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "download" | "changelog" | "privacy";
}

const { title, description, current } = Astro.props;
const policy =
  "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={policy} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preload" href="/fonts/GoogleSansFlex.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="site">
      <div class="page">
        <Header current={current} />
        <main>
          <slot />
        </main>
      </div>
      <Footer />
    </div>
  </body>
</html>
