---
import Icon from "../components/Icon.astro";
import Base from "../layouts/Base.astro";
---
<Base title="Page not found · Diffloupe" description="This page does not exist. Diffloupe itself is one command away." indexed={false}>
  <section class="wrap missing" aria-labelledby="missing-title">
    <p class="eyebrow-mono">Error 404</p>
    <h1 class="h1-doc" id="missing-title">This page is not here.</h1>
    <p class="sub">The link may be old or mistyped. Diffloupe itself is one command away.</p>
    <div class="hero-actions">
      <a class="btn btn-primary btn-lg" href="/download/"><Icon name="download" size="sm" />Download</a>
      <a class="btn btn-outline btn-lg" href="/">Back to the home page</a>
    </div>
  </section>
</Base>
