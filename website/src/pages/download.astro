---
import Icon from "../components/Icon.astro";
import StarPanel from "../components/StarPanel.astro";
import Base from "../layouts/Base.astro";
import {
  formatSize,
  latestFor,
  latestRelease,
  repository,
  setupName,
  type WindowsRelease,
} from "../lib/release";
import "../styles/download.css";

const macos = await latestRelease();
const linux = await latestFor("linux");
const windows = await latestFor("windows");

const windowsFallback: WindowsRelease = {
  version: macos.version,
  date: macos.date,
  setup: {
    name: setupName(macos.version),
    url: `https://github.com/${repository}/releases/download/v${macos.version}/${setupName(macos.version)}`,
    size: 13_100_000,
    sha256: "",
  },
};
const win = windows ?? windowsFallback;

const macosSize = formatSize(macos.dmg.size);
const debSize = linux ? formatSize(linux.deb.size) : "";
const rpmSize = linux ? formatSize(linux.rpm.size) : "";
const windowsSize = formatSize(win.setup.size);

const curl = "curl -fsSL ";
const pipe = "https://diffloupe.com/install.sh | bash";
const command = curl + pipe;
const winCommand = "irm https://diffloupe.com/install.ps1 | iex";
const xattr = "xattr -dr com.apple.quarantine /Applications/Diffloupe.app";
const aptCmd = linux ? `sudo apt install ./${linux.deb.name}` : "";
const dnfCmd = linux ? `sudo dnf install ./${linux.rpm.name}` : "";

const benefits = [
  {
    icon: "shield-outline",
    title: "Stays on your computer",
    text: "No account and no trackers. The code is open source, and everything stays on your computer.",
  },
  {
    icon: "check",
    title: "A checked download",
    text: "The command compares the download's SHA-256 checksum before it installs anything.",
  },
  {
    icon: "refresh",
    title: "Updates itself",
    text: "Diffloupe offers each new version and installs it with one click. Your settings stay.",
  },
] as const;
---
<Base title="Download · Diffloupe" description="Install Diffloupe with one command, or download the package for your system. Free and open source." current="download">
  <div class="wrap">
    <section class="dl-hero" id="macos" data-platform-section="macos" aria-labelledby="download-title-macos">
      <span class="dl-glow" aria-hidden="true"></span>
      <div class="dl-hero-header">
        <h1 class="dl-title" id="download-title-macos">Download Diffloupe</h1>
        <p class="dl-sub">Fast, local git diff viewer for macOS, Windows and Linux. Everything stays on your computer.</p>
      </div>
      <div class="install">
        <div class="install-card">
          <div class="install-tabs" role="tablist" aria-label="Platform">
            <a class="install-tab" href="#macos" aria-current="true" role="tab" aria-selected="true"><Icon name="apple" size="sm" /><span>macOS</span></a>
            <a class="install-tab" href="#windows" role="tab" aria-selected="false"><Icon name="windows" size="sm" /><span>Windows</span></a>
            <a class="install-tab" href="#linux" role="tab" aria-selected="false"><Icon name="linux" size="sm" /><span>Linux</span></a>
          </div>
          <div class="install-in">
            <div class="install-top">
              <div>
                <p class="eyebrow-mono">One-line install</p>
                <h2 class="install-title">Paste this in Terminal.</h2>
              </div>
              <span class="install-icon" aria-hidden="true"><Icon name="terminal" /></span>
            </div>
            <div class="cmd cmd-dark">
              <code><span class="prompt">$ </span>{curl}<span class="cmd-url">{pipe}</span></code>
              <button class="icon-btn" type="button" aria-label="Copy the install command" data-copy={command}><Icon name="copy" size="sm" /></button>
            </div>
            <p class="install-note">The script checks the download's SHA-256 checksum, installs into Applications and keeps your settings. Read it first at <a href="/install.sh">diffloupe.com/install.sh</a>.</p>
            <div class="install-actions">
              <button class="btn btn-light" type="button" data-copy={command}><Icon name="copy" size="sm" /><span data-label aria-live="polite">Copy command</span></button>
              <a class="install-alt" href="#manual">Download the disk image instead</a>
            </div>
          </div>
        </div>
        <ul class="chips chips-center" aria-label="Requirements">
          <li class="chip"><Icon name="apple" size="sm" />macOS 13 or later</li>
          <li class="chip"><Icon name="chip" />Apple silicon</li>
          <li class="chip"><Icon name="no-account" />No account</li>
        </ul>
        <p class="install-caption">Version {macos.version} · {macosSize} · Disk image checked by SHA-256</p>
        <StarPanel />
      </div>
    </section>

    <section class="dl-hero" id="windows" data-platform-section="windows" aria-labelledby="download-title-windows">
      <span class="dl-glow" aria-hidden="true"></span>
      <div class="dl-hero-header">
        <h1 class="dl-title" id="download-title-windows">Download Diffloupe</h1>
        <p class="dl-sub">Fast, local git diff viewer for macOS, Windows and Linux. Everything stays on your computer.</p>
      </div>
      <div class="install">
        <div class="install-card">
          <div class="install-tabs" role="tablist" aria-label="Platform">
            <a class="install-tab" href="#macos" role="tab" aria-selected="false"><Icon name="apple" size="sm" /><span>macOS</span></a>
            <a class="install-tab" href="#windows" aria-current="true" role="tab" aria-selected="true"><Icon name="windows" size="sm" /><span>Windows</span></a>
            <a class="install-tab" href="#linux" role="tab" aria-selected="false"><Icon name="linux" size="sm" /><span>Linux</span></a>
          </div>
          <div class="install-in">
            <div class="install-top">
              <div>
                <p class="eyebrow-mono">One-line install</p>
                <h2 class="install-title">Paste this in PowerShell.</h2>
              </div>
              <span class="install-icon" aria-hidden="true"><Icon name="terminal" /></span>
            </div>
            <div class="cmd cmd-dark">
              <code><span class="prompt">PS&gt; </span>irm <span class="cmd-url">https://diffloupe.com/install.ps1 | iex</span></code>
              <button class="icon-btn" type="button" aria-label="Copy the install command" data-copy={winCommand}><Icon name="copy" size="sm" /></button>
            </div>
            <p class="install-note">The script checks the download's SHA-256 checksum, installs for your user and keeps your settings. Read it first at diffloupe.com/install.ps1.</p>
            <div class="install-actions">
              <button class="btn btn-light" type="button" data-copy={winCommand}><Icon name="copy" size="sm" /><span data-label aria-live="polite">Copy command</span></button>
              <a class="install-alt" href="#manual-windows">Download the setup program instead</a>
            </div>
          </div>
        </div>
        <ul class="chips chips-center" aria-label="Requirements">
          <li class="chip"><Icon name="windows" size="sm" />Windows 10 or 11</li>
          <li class="chip"><Icon name="chip" />64-bit</li>
          <li class="chip"><Icon name="no-account" />No account</li>
        </ul>
        <p class="install-caption">Version {win.version} · {windowsSize} · Setup program checked by SHA-256</p>
        <StarPanel />
      </div>
    </section>

    {linux && (
      <section class="dl-hero" id="linux" data-platform-section="linux" aria-labelledby="download-title-linux">
        <span class="dl-glow" aria-hidden="true"></span>
        <div class="dl-hero-header">
          <h1 class="dl-title" id="download-title-linux">Download Diffloupe</h1>
          <p class="dl-sub">Fast, local git diff viewer for macOS, Windows and Linux. Everything stays on your computer.</p>
        </div>
        <div class="install">
          <div class="install-card">
            <div class="install-tabs" role="tablist" aria-label="Platform">
              <a class="install-tab" href="#macos" role="tab" aria-selected="false"><Icon name="apple" size="sm" /><span>macOS</span></a>
              <a class="install-tab" href="#windows" role="tab" aria-selected="false"><Icon name="windows" size="sm" /><span>Windows</span></a>
              <a class="install-tab" href="#linux" aria-current="true" role="tab" aria-selected="true"><Icon name="linux" size="sm" /><span>Linux</span></a>
            </div>
            <div class="install-in">
              <div class="install-top">
                <div>
                  <p class="eyebrow-mono">One-line install</p>
                  <h2 class="install-title">Paste this in a terminal.</h2>
                </div>
                <span class="install-icon" aria-hidden="true"><Icon name="terminal" /></span>
              </div>
              <div class="cmd cmd-dark">
                <code><span class="prompt">$ </span>{curl}<span class="cmd-url">{pipe}</span></code>
                <button class="icon-btn" type="button" aria-label="Copy the install command" data-copy={command}><Icon name="copy" size="sm" /></button>
              </div>
              <p class="install-note">The script checks the download's SHA-256 checksum, installs the .deb or .rpm with sudo and keeps your settings. Read it first at <a href="/install.sh">diffloupe.com/install.sh</a>.</p>
              <div class="install-actions">
                <button class="btn btn-light" type="button" data-copy={command}><Icon name="copy" size="sm" /><span data-label aria-live="polite">Copy command</span></button>
                <a class="install-alt" href="#manual-linux">Download the package instead</a>
              </div>
            </div>
          </div>
          <ul class="chips chips-center" aria-label="Requirements">
            <li class="chip"><Icon name="linux" size="sm" />Ubuntu, Debian, Fedora</li>
            <li class="chip"><Icon name="chip" />64-bit</li>
            <li class="chip"><Icon name="no-account" />No account</li>
          </ul>
          <p class="install-caption">Version {linux.version} · {debSize} · Package checked by SHA-256</p>
          <StarPanel />
        </div>
      </section>
    )}
  </div>

  <section class="manual" id="manual" aria-label="Manual install">
    <div class="wrap wrap-rows manual-in" data-platform-section="macos">
      <div>
        <p class="eyebrow">Manual install</p>
        <h2 class="h2-steps" id="manual-title">Prefer the disk image?</h2>
        <p class="small">Download the .dmg and install it by hand. Diffloupe is free, and Apple's developer account costs about €100 a year, so the app is not notarised yet. macOS asks you once before the first start.</p>
        <a class="btn btn-outline btn-lg" href={macos.dmg.url} data-download><Icon name="download" size="sm" />Download {macos.dmg.name}</a>
        <p class="manual-meta">{macosSize} · Apple silicon · macOS 13 or later</p>
        <StarPanel />
      </div>
      <ol class="dl-steps">
        <li class="dl-step"><span class="dl-step-num">01</span><div><h3>Open the disk image</h3><p>Double-click {macos.dmg.name} in your Downloads folder.</p></div></li>
        <li class="dl-step"><span class="dl-step-num">02</span><div><h3>Drag Diffloupe to Applications</h3><p>Move the icon into Applications, then eject the disk image.</p></div></li>
        <li class="dl-step"><span class="dl-step-num">03</span><div><h3>Allow the first start</h3><p>macOS says it cannot check the app. Allow it in one of two ways:</p>
          <div class="cmd cmd-light"><code>System Settings → Privacy &amp; Security → Open Anyway</code><span class="icon-btn" aria-hidden="true"><Icon name="settings" size="sm" /></span></div>
          <p class="or or-light">OR</p>
          <div class="cmd cmd-light"><code>{xattr}</code><button class="icon-btn" type="button" aria-label="Copy the xattr command" data-copy={xattr}><Icon name="copy" size="sm" /></button></div>
        </div></li>
      </ol>
    </div>

    <div class="wrap wrap-rows manual-in" id="manual-windows" data-platform-section="windows">
      <div>
        <p class="eyebrow">Manual install</p>
        <h2 class="h2-steps" id="manual-title-windows">Prefer the setup program?</h2>
        <p class="small">Download the .exe and run it. Diffloupe is free, and a code-signing certificate costs money, so the setup program is not signed yet. Windows asks you once before the first start.</p>
        <a class="btn btn-outline btn-lg" href={win.setup.url} data-download><Icon name="download" size="sm" />Download {win.setup.name}</a>
        <p class="manual-meta">{windowsSize} · 64-bit · Windows 10 or 11</p>
        <StarPanel />
      </div>
      <ol class="dl-steps">
        <li class="dl-step"><span class="dl-step-num">01</span><div><h3>Run the setup program</h3><p>Double-click {win.setup.name} in your Downloads folder.</p></div></li>
        <li class="dl-step"><span class="dl-step-num">02</span><div><h3>Allow the first start</h3><p>Windows says it protected your PC. Allow it once:</p>
          <div class="cmd cmd-light"><code>More info → Run anyway</code><span class="icon-btn" aria-hidden="true"><Icon name="settings" size="sm" /></span></div>
        </div></li>
        <li class="dl-step"><span class="dl-step-num">03</span><div><h3>Start Diffloupe</h3><p>Open it from the Start menu. It installs for your user and needs no administrator rights.</p></div></li>
      </ol>
    </div>

    {linux && (
      <div class="wrap wrap-rows manual-in" id="manual-linux" data-platform-section="linux">
        <div>
          <p class="eyebrow">Manual install</p>
          <h2 class="h2-steps" id="manual-title-linux">Prefer the package?</h2>
          <p class="small">Download the .deb or the .rpm and install it with your package manager. Diffloupe is free and open source, so it is not in an app store.</p>
          <a class="btn btn-outline btn-lg" href={linux.deb.url} data-download><Icon name="download" size="sm" />Download {linux.deb.name}</a>
          <p class="manual-meta">{debSize} · 64-bit · Ubuntu 22.04, Debian 12 or later</p>
          <p class="manual-meta">On Fedora or Red Hat? <a class="text-link" href={linux.rpm.url} data-download>Download the .rpm</a> instead ({rpmSize}).</p>
          <StarPanel />
        </div>
        <ol class="dl-steps">
          <li class="dl-step"><span class="dl-step-num">01</span><div><h3>Download the package</h3><p>Get the .deb for Ubuntu and Debian, or the .rpm for Fedora.</p></div></li>
          <li class="dl-step"><span class="dl-step-num">02</span><div><h3>Install it</h3><p>Run one of these in the folder you downloaded it to:</p>
            <div class="cmd cmd-light"><code>{aptCmd}</code><button class="icon-btn" type="button" aria-label="Copy the apt command" data-copy={aptCmd}><Icon name="copy" size="sm" /></button></div>
            <p class="or or-light">OR</p>
            <div class="cmd cmd-light"><code>{dnfCmd}</code><button class="icon-btn" type="button" aria-label="Copy the dnf command" data-copy={dnfCmd}><Icon name="copy" size="sm" /></button></div>
          </div></li>
          <li class="dl-step"><span class="dl-step-num">03</span><div><h3>Start Diffloupe</h3><p>Open it from your application menu, or run diffloupe in a terminal.</p></div></li>
        </ol>
      </div>
    )}
  </section>

  <div class="wrap">
    <section class="benefits" aria-label="Why install this way">
      {benefits.map((benefit) => <div class="benefit"><Icon name={benefit.icon} /><h3>{benefit.title}</h3><p>{benefit.text}</p></div>)}
    </section>
  </div>
  <script>
    import { copyButtons } from "../scripts/copy";
    import { choosePlatform } from "../scripts/platform";
    import { starPanels } from "../scripts/star";
    choosePlatform();
    copyButtons();
    starPanels();
  </script>
</Base>